<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Tap&amp;Talk</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>XPC!</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <!-- Mikrofonen är det enda tangentbordet ber om, och bara när man
         trycker på Tala. Ingenting av det som skrivs lämnar telefonen. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Mikrofonen används när du trycker på Tala i tangentbordet.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Ditt tal görs om till text i det fält du skriver i.</string>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionAttributes</key>
        <dict>
            <!-- Svensk layout, inte bara ASCII: å, ä och ö måste få plats. -->
            <key>IsASCIICapable</key>
            <false/>
            <key>PrefersRightToLeft</key>
            <false/>
            <key>PrimaryLanguage</key>
            <string>sv-SE</string>
            <!-- Krävs för mikrofonen. Ett tangentbord utan fullständig
                 åtkomst får inte spela in, och kan inte be om det själv:
                 därför säger tangentbordet det i stället och hänvisar till
                 appen. -->
            <key>RequestsOpenAccess</key>
            <true/>
        </dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.keyboard-service</string>
        <key>NSExtensionPrincipalClass</key>
        <string>$(PRODUCT_MODULE_NAME).KeyboardController</string>
    </dict>
</dict>
</plist>
