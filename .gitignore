# Xcode-projektet genereras av XcodeGen och versionshanteras inte.
ios/Rostsvar.xcodeproj/
ios/build/
ios/DerivedData/
ios/App/Info.plist
xcuserdata/
*.xcuserstate
*.xcarchive

# Android-bygget. Innehåller bland annat en lokal testnyckel som
# aldrig ska in i historiken.
android/build/
android/.gradle/
android/app/build/
*.p12
*.keystore
*.jks

# Releasenyckelns lösenord står i din egen gradle.properties i
# användarmappen, utanför repot. En gradle.properties här inne är
# nästan alltid en kopia av den som råkat hamna fel. Behövs en riktig
# projektfil en dag: git add -f.
gradle.properties
local.properties
*.p8
*.mobileprovision
*.cer

# Skräp
.DS_Store
Thumbs.db
__pycache__/

# Sidkopior från Playwright, skapas vid felsökning i webbläsare.
.playwright-mcp/
